# French Mastery Hub — Environment Variables
# Copy to .env for local dev
# Set these in Railway dashboard for production

# ── Required ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string_in_production

# ── Optional: AI Writing Feedback ─────────────────────────────────────────────
# Get a key at platform.openai.com — costs pennies per use
OPENAI_API_KEY=optional

# ── Production only ───────────────────────────────────────────────────────────
# Set CLIENT_URL to your Vercel URL if deploying frontend separately
# Leave blank if using Railway to serve everything (recommended)
# CLIENT_URL=https://your-app.vercel.app
